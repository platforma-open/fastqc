{
  "name": "@platforma-open/milaboratories.fastqc",
  "version": "2.2.6",
  "files": [
    "dist",
    "block-pack"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "sources": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "pretty": "prettier --write \"./**/*.{js,jsx,mjs,cjs,ts,tsx,json,vue}\"",
    "build": "ts-builder build --target block-facade && block-tools pack",
    "mark-stable": "block-tools mark-stable -r 's3://milab-euce1-prod-pkgs-s3-block-registry/pub/releases/?region=eu-central-1'",
    "prepublishOnly": "block-tools publish -r s3://milab-euce1-prod-pkgs-s3-block-registry/pub/releases/?region=eu-central-1 --registry-serve-url https://blocks.pl-open.science",
    "check": "ts-builder type-check --target block-facade",
    "do-pack": "shx rm -f package.tgz && pnpm pack && shx mv *.tgz package.tgz"
  },
  "dependencies": {},
  "devDependencies": {
    "@milaboratories/ts-builder": "catalog:",
    "@milaboratories/ts-configs": "catalog:",
    "@platforma-open/milaboratories.fastqc.kind": "workspace:*",
    "@platforma-open/milaboratories.fastqc.model": "workspace:*",
    "@platforma-open/milaboratories.fastqc.ui": "workspace:*",
    "@platforma-open/milaboratories.fastqc.workflow": "workspace:*",
    "@platforma-sdk/block-tools": "catalog:",
    "@platforma-sdk/model": "catalog:",
    "shx": "catalog:",
    "typescript": "catalog:",
    "unzipper": "catalog:"
  },
  "packageManager": "pnpm@9.12.0",
  "block": {
    "components": {
      "workflow": "@platforma-open/milaboratories.fastqc.workflow/dist/tengo/tpl/main.plj.gz",
      "model": "@platforma-open/milaboratories.fastqc.model/dist/model.json",
      "ui": "@platforma-open/milaboratories.fastqc.ui/dist"
    },
    "meta": {
      "title": "FastQC",
      "logo": "file:../logos/block-logo.png",
      "url": "https://github.com/platforma-open/fastqc",
      "support": "mailto:support@milaboratories.com",
      "description": "Performs quality control analysis on FASTQ sequencing files using FastQC, generating comprehensive QC reports with metrics on sequence quality, base composition, adapter content, and duplication levels.",
      "longDescription": "file:../docs/description.md",
      "changelog": "file:../CHANGELOG.md",
      "tags": [
        "Upstream",
        "FASTQ"
      ],
      "organization": {
        "name": "MiLaboratories Inc",
        "url": "https://milaboratories.com/",
        "logo": "file:../logos/milaboratories.png"
      },
      "marketplaceRanking": 17900
    }
  }
}
