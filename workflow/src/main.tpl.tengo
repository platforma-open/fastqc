wf := import("@platforma-sdk/workflow-tengo:workflow")
assets := import("@platforma-sdk/workflow-tengo:assets")
llPFrames := import("@platforma-sdk/workflow-tengo:pframes.ll")

// FastQC program template
fastqcTpl := assets.importTemplate(":fastqc")

// Prepare input inherited from previous job
wf.prepare(func(args) {
	return {
		// reference to Fastq files
		resolvedFastq: wf.resolve(args.refData, { errIfMissing: true })
	}
})

wf.body(func(args) {
	input := args.resolvedFastq

	// Fastq or Fastq.gz
	fileExtension := input.spec.domain["pl7.app/fileExtension"]

	aggregationTargets := [{
		type: "Resource",
		name: "FastQChtmlR1"
	}, {
		type: "Resource",
		name: "FastQChtmlR2"
	}, {
		type: "Resource",
		name: "fastQCstdout"
	}]

	// Groups the files by sample (axis 0), so each run gets that sample's reads keyed by read index
	fastqcResults := llPFrames.aggregate(
		input.data, [1], fastqcTpl,
		aggregationTargets,
		false,
		{
			fileExtension: fileExtension
		}
	)

	return {
		outputs: {
			fastQCstdout: fastqcResults.output("fastQCstdout"),
			// Standalone HTML reports, shown by the UI. Earlier versions passed on the report
			// archives (FastQCzipR1/R2) instead; the model still reads those from older results.
			FastQChtmlR1: fastqcResults.output("FastQChtmlR1"),
			FastQChtmlR2: fastqcResults.output("FastQChtmlR2")
		},

		exports: {}
	}
})
